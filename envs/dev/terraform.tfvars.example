# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

project_id = "your-gcp-project-id"
# region   = "europe-west9"   # Paris (default)

# Worker image, pinned by digest (build + push first — see README).
image = "europe-west9-docker.pkg.dev/your-gcp-project-id/pma-workers/worker@sha256:..."

# Optional overrides:
# catalog_url        = "https://www.betclic.fr/football-sfootball"
# impersonate        = "firefox"
# dataset            = "betting"
# raw_retention_days = 30
# ingest_schedule    = "0 * * * *"
# transform_schedule = "20 * * * *"

# Keep schedulers paused until a manual run is verified, then set false.
schedulers_paused = true
